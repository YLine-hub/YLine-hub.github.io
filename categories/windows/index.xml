		class=&#34;gallery-image&#34; 
		data-flex-grow=&#34;772&#34;
		data-flex-basis=&#34;1854px&#34;
	
&gt;&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;重新配置ipconfig环境变量&lt;/li&gt;
&lt;/ul&gt;
&lt;div class=&#34;highlight&#34;&gt;&lt;div class=&#34;chroma&#34;&gt;
&lt;table class=&#34;lntable&#34;&gt;&lt;tr&gt;&lt;td class=&#34;lntd&#34;&gt;
&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code&gt;&lt;span class=&#34;lnt&#34;&gt;1
&lt;/span&gt;&lt;span class=&#34;lnt&#34;&gt;2
&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;
&lt;td class=&#34;lntd&#34;&gt;
&lt;pre tabindex=&#34;0&#34; class=&#34;chroma&#34;&gt;&lt;code class=&#34;language-fallback&#34; data-lang=&#34;fallback&#34;&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;# 路径
&lt;/span&gt;&lt;/span&gt;&lt;span class=&#34;line&#34;&gt;&lt;span class=&#34;cl&#34;&gt;C:\Windows\System32
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;
&lt;/div&gt;
&lt;/div&gt;&lt;ul&gt;
&lt;li&gt;再次查看&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;&lt;img src=&#34;https://YLine-hub.github.io/p/windowsmac%E5%92%8Cwin%E5%AE%9E%E7%8E%B0%E6%96%87%E4%BB%B6%E4%BA%92%E4%BC%A0/image-9.png&#34;
	width=&#34;626&#34;
	height=&#34;142&#34;
	srcset=&#34;https://YLine-hub.github.io/p/windowsmac%E5%92%8Cwin%E5%AE%9E%E7%8E%B0%E6%96%87%E4%BB%B6%E4%BA%92%E4%BC%A0/image-9_hu_bc394a680bd5c6dc.png 480w, https://YLine-hub.github.io/p/windowsmac%E5%92%8Cwin%E5%AE%9E%E7%8E%B0%E6%96%87%E4%BB%B6%E4%BA%92%E4%BC%A0/image-9_hu_4f24b0bc48a9f94.png 1024w&#34;
